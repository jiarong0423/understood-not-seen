#!/bin/sh
# Runs before every push: secret scan over the history and the whole test suite. Stops the push if either fails.
# Enable once per clone: git config core.hooksPath .githooks   (the full scan is: npm run security)
cd "$(git rev-parse --show-toplevel)" || exit 1
command -v gitleaks >/dev/null 2>&1 || { echo "ERROR gitleaks is not installed: refusing to push without a secret scan"; exit 1; }
npm run --silent prepush || { echo "ERROR pre-push checks failed"; exit 1; }
